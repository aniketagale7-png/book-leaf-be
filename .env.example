# Django Settings
SECRET_KEY=django-insecure-bookleaf-backend-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'postgresql'
DB_ENGINE=sqlite

# PostgreSQL Configuration (used when DB_ENGINE=postgresql)
DB_NAME=bookleaf_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AI Operations Desk (Section D - Optional: gemini / openai / anthropic)
# If no key is provided, system operates on intelligent BookLeaf Knowledge Base heuristics with 0 downtime
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
